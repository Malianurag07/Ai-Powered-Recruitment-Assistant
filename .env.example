# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=paste the key here         # console.groq.com  (extraction, classification, scoring)
GEMINI_API_KEY=paste the key here      # aistudio.google.com (verification, recruiter chat)
GROQ_FAST_MODEL=qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
DATABASE_PATH=data/recruitment.db

# Authentication (on by default: the first account to register becomes the admin; set 0 for no login at all)
AUTH_ENABLED=1
SESSION_SECRET=any long random string    # signs login cookies; python -c "import secrets; print(secrets.token_hex(32))"
SESSION_HOURS=12
ALLOW_REGISTRATION=1             # 1 = anyone can create a recruiter account on the login screen; 0 = admins add users only
# Optional: create the first admin from .env instead of registering it in the browser
#ADMIN_EMAIL=admin@example.com
#ADMIN_PASSWORD=choose a password, 8+ characters

# Optional local model (install Ollama, then: ollama pull llama3.2:3b)
OLLAMA_MODEL=llama3.2:3b

# Tuning (optional)
JUDGE_SAMPLES=3            # AI judgments per candidate, median kept (1 = faster and cheaper, 3 = more repeatable)
LLM_MAX_CONCURRENCY=4      # max simultaneous AI calls, protects free-tier rate limits

# Self-hosted mode: "cloud" (Groq + Gemini, default) or "local" (everything through Ollama, nothing leaves this machine)
LLM_MODE=cloud
# Semantic search over resumes (Gemini embeddings). Set SEMANTIC_INDEXING=0 to use keyword search only.
SEMANTIC_INDEXING=1
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIMS=768

# Optional: free-tier planning numbers for the upload-time estimate (set the real limits for your keys), pauses, and OCR for scanned PDFs
# GROQ_FAST_CALLS_PER_DAY=1000
# GROQ_CALLS_PER_DAY=1000
# GEMINI_CALLS_PER_DAY=500
# BATCH_PAUSE_SECONDS=2
# BATCH_PAUSE_AFTER_LIMIT_SECONDS=12
# OCR_ENABLED=1
# OCR_MAX_PAGES=3
